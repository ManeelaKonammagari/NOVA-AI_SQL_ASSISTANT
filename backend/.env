APP_NAME=NOVA AI SQL ASSISTANT
ENVIRONMENT=development
NOVA_SECRET_KEY="your_secret_key"
NOVA_ACCESS_TOKEN_EXPIRE_MINUTES=2
NOVA_REFRESH_TOKEN_EXPIRE_HOURS=5

# Optional database connection for the SQL engine
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD="Mysql_pwd"
MYSQL_DATABASE=text_to_sql

# Optional AI providers

AI_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY="your_groq_api-key"


GOOGLE_API_KEY="your_google_api_key"

# Google Authentication
GOOGLE_CLIENT_ID="your_google_client_id"